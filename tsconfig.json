{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "strict": true,
    "jsx": "react-jsx",
    "noEmit": true,
    "skipLibCheck": true
  },
  "include": [
    "packages/shared/src/**/*.ts",
    "functions/src/**/*.ts",
    "apps/mobile/src/**/*.ts",
    "apps/mobile/src/**/*.tsx",
    "apps/web/src/**/*.ts",
    "apps/web/src/**/*.tsx"
  ]
}
